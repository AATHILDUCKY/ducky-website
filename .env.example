DATABASE_URL=postgresql://ducky:CHANGE_ME@127.0.0.1:55432/ducky
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password
SESSION_SECRET=replace-with-at-least-32-random-characters
SITE_URL=http://localhost:3000
# Set true behind an HTTPS reverse proxy in production.
COOKIE_SECURE=false
PORT=3000
# Use 127.0.0.1 when running behind a local reverse proxy.
APP_HOST=0.0.0.0
# Responsive display ad unit's numeric data-ad-slot (publisher ID is already configured).
# Leave empty to disable ad requests and placements. Rebuild after changing.
NEXT_PUBLIC_ADSENSE_DISPLAY_SLOT=
