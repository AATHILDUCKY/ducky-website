# Place inside an existing nginx http {} context; enable HTTPS with your certificate tooling.
server {
    listen 80;
    server_name aathilducky.com www.aathilducky.com;
    client_max_body_size 11m;
    gzip on;
    gzip_types text/css application/javascript application/json application/xml image/svg+xml;
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 60s;
    }
    location /_next/static/ {
        proxy_pass http://127.0.0.1:3000;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
